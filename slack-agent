def profile_projects() -> Path:
    return Path(CONFIG["claude_projects"])


def ui_status(channel: str) -> dict:
    state = read_json(conv_state(channel), {})
    ws = state.get("workspace", "")
    folder = profile_projects() / re.sub(r"[^A-Za-z0-9]", "-", ws)
    turns, last, seen = [], None, set()
    files = sorted(folder.glob("*.jsonl"), key=lambda f: f.stat().st_mtime) if folder.exists() else []
    if files:
        for line in files[-1].read_text().splitlines():
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            u = (d.get("message") or {}).get("usage") if d.get("type") == "assistant" else None
            mid = (d.get("message") or {}).get("id")
            if u and mid not in seen:  # one API call is written once per content block
                seen.add(mid)
                last = (d, u)
                turns.append({"cache_read": u.get("cache_read_input_tokens", 0),
                              "input": u.get("input_tokens", 0) + u.get("cache_creation_input_tokens", 0),
                              "output": u.get("output_tokens", 0)})
    expires, context = None, "—"
    if last:
        d, u = last
        ttl = 3600 if (u.get("cache_creation") or {}).get("ephemeral_1h_input_tokens") else 300
        at = time.mktime(time.strptime(d["timestamp"][:19], "%Y-%m-%dT%H:%M:%S")) - time.timezone
        expires = at + ttl
        context = f'{u.get("input_tokens", 0) + u.get("cache_creation_input_tokens", 0) + u.get("cache_read_input_tokens", 0):,}'
    git = "—"
    if ws and Path(ws).exists():
        g = lambda *a: subprocess.run(["git", "-C", ws, *a], capture_output=True, text=True).stdout.strip()
        ahead = g("rev-list", "--count", f"origin/{base_branch()}..HEAD")
        dirty = len(g("status", "--porcelain").splitlines())
        git = f"{state.get('branch', '')} · {ahead} ahead · {dirty} uncommitted"
    return {"status": state.get("status", "—"), "title": f"Live · {Path(ws).name}", "cache_expires": expires,
            "context": context, "git": git, "turns": turns[-40:]}


