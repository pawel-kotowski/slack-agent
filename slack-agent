class Listener:
    def __init__(self) -> None:
        self.web = WebClient(token=secret("bot"))
        auth = self.web.auth_test()
        self.bot_user, self.team = auth["user_id"], auth["team_id"]
        self.sessions = read_json(SESSIONS, {})
        self.seen: dict[str, float] = {}
        self.code_channels: dict[str, dict | None] = {}
        self.answered: set[str] = set()  # questions with buttons that got their click
        self.lock = threading.Lock()

    def save(self) -> None:
        write_json(SESSIONS, self.sessions)

    def owner(self, user: str | None) -> str | None:
        return CONFIG["owners"].get(user or "")

    def display(self, user: str | None) -> str:
        if self.owner(user):
            return self.owner(user)
        try:
            p = self.web.users_info(user=user)["user"]
            return p.get("real_name") or p.get("name") or str(user)
        except SlackApiError:
            return str(user)

    def named(self, text: str) -> str:
        """Slack's <@U123> mentions as @Name, so the screen sees who is addressed."""
        return re.sub(r"<@(U[A-Z0-9]+)(?:\|[^>]*)?>",
                      lambda m: f"@{CONFIG['bot_name']}" if m.group(1) == self.bot_user else "@" + self.display(m.group(1)),
                      text or "")

    def clean(self, text: str) -> str:
        text = re.sub(r"\s*\*Sent using\* \S+$", "", text or "")  # the footer of a message posted from an app
        return re.sub(rf"<@{self.bot_user}>\s*", "", text).strip()

    def code_channel(self, channel: str) -> dict | None:
        """The channel's agent_session properties if it is a code channel, else None."""
        if channel not in self.code_channels:
            try:
                props = self.web.conversations_info(channel=channel)["channel"].get("properties") or {}
            except SlackApiError:
                props = {}
            is_code = (props.get("record_channel") or {}).get("record_type") == "agent_channel"
            self.code_channels[channel] = (props.get("agent_session") or {}) if is_code else None
        return self.code_channels[channel]

    def moved(self, channel: str) -> str | None:
        """Re-key a session thread that `open-channel` moved to this code channel."""
        for conv in list(self.sessions):
            if "-" in conv and read_json(conv_state(conv), {}).get("moved_to") == channel:
                self.sessions[channel] = {**self.sessions.pop(conv), "conv": channel, "thread_conv": conv}
                self.save()
                log("moved", conv, "to", channel)
                return channel
        return None

    # --- events ---------------------------------------------------------------------------

    def handle(self, event: dict) -> None:
        kind = event.get("type")
        if kind == "agent_session_stopped":
            return self.stop(event)
        if kind in ("channel_archive", "group_archive"):
            return self.cleanup(self.conv_of(event.get("channel"), None))
        if kind == "agent_session_title_changed":
            conv = self.conv_of(event.get("channel"), event.get("thread_ts"))
            if conv:
                self.sessions[conv]["title"] = event.get("title")
                self.save()
            return
        if kind not in ("app_mention", "message") or event.get("subtype") or event.get("bot_id"):
            return
        user, channel, ts = event.get("user"), event.get("channel"), event.get("ts")
        if not user or user == self.bot_user:
            return
        key = f"{channel}:{ts}"
        if key in self.seen:
            return
        conv = self.conv_of(channel, event.get("thread_ts"))
        is_dm = event.get("channel_type") == "im"
        code = None if conv or is_dm else self.code_channel(channel)
        origin = ((code or {}).get("origin_link") or {}).get("channel_id")
        if not conv and not is_dm and not channel_allowed(channel) and not channel_allowed(origin):
            if kind == "app_mention":  # a tag elsewhere: say where the bot works, to the tagger only
                log("ignored: not in channels", channel)
                try:
                    self.web.chat_postEphemeral(channel=channel, user=user, thread_ts=event.get("thread_ts"),
                                                text="I don't work in this channel: it is not on my list.")
                except SlackApiError:
                    pass
            return
        if not conv and not is_dm and code is None and kind != "app_mention":
            # A channel message outside any task. A mention in it comes again as app_mention, often
            # after this event, so this one must not mark the message seen.
            return
        self.seen[key] = time.time()
        text = self.clean(event.get("text", "")) or self.bare_mention(channel, event.get("thread_ts"), user)
        if SEED.match(text):
            return  # Slack seeds a new code channel with the request it came from.
        if conv:
            return self.on_message(conv, user, event.get("text", ""), text, ts)
        if code is not None:
            # A code channel we have no session for: started from Slack's own UI,
            # or forgotten after a restart. Pick it up.
            if self.owner(user):
                link = code.get("origin_link") or {}
                self.start(channel, user, text, link.get("channel_id") or channel, link.get("ts") or ts)
            return
        if is_dm and event.get("thread_ts"):
            return  # a reply in a DM thread whose session is gone
        if kind == "app_mention" or is_dm:
            if not self.owner(user):
                self.web.chat_postEphemeral(channel=channel, user=user, thread_ts=event.get("thread_ts"),
                                            text=f"Only {OWNER} can start tasks with me for now. Ask them to start one and invite you.")
                return
            root = event.get("thread_ts") or ts
            self.start(f"{channel}-{root}", user, text, channel, ts)

    def bare_mention(self, channel: str, thread: str | None, user: str) -> str:
        """The task of a mention without words: the message that starts its thread."""
        who = self.display(user)
        if not thread:
            return f"({who} mentioned you without a message.)"
        try:
            root = self.web.conversations_replies(channel=channel, ts=thread, limit=1)["messages"][0]
        except (SlackApiError, IndexError, KeyError):
            return f"({who} mentioned you in a thread without a message.)"
        text = re.sub(r"<@(U[A-Z0-9]+)(?:\|[^>]*)?>", lambda m: "@" + self.display(m.group(1)), root.get("text", ""))
        return (f"{text}\n\n({self.display(root.get('user'))} wrote this to start the thread; "
                f"{who} mentioned you under it without a message.)")

    def conv_of(self, channel: str | None, thread: str | None) -> str | None:
        if thread and f"{channel}-{thread}" in self.sessions:
            return f"{channel}-{thread}"
        if channel in self.sessions:
            return channel
        return self.moved(channel) if channel else None

    def command(self, channel: str, user: str, command: str, text: str) -> str:
        conv = self.conv_of(channel, None)
        if not conv:
            return "I have no task in this channel. Mention me to start one."
        if command == "/done" and not self.owner(user):
            return f"Only {OWNER} can finish this task."
        if command == "/preview-login":
            preview = read_json(conv_state(conv), {}).get("preview")
            if user not in CONFIG["wakers"]:
                return "Only people who can wake the agent get the preview login."
            if not preview:
                return "No preview runs here. Start one with /preview."
            return preview["password"]  # alone, so copying the message copies just the password
        if command == "/preview":
            if not CONFIG["preview"]:
                return "No preview is set up for this project."
            if user not in CONFIG["wakers"]:
                return "Only people who can wake the agent can start a preview."
            preview_start(self.web, conv)
            return ""
        if command == "/diff":
            # Done here, so the tab refreshes with no live session.
            ws = read_json(conv_state(conv), {}).get("workspace")
            if not ws or not Path(ws).is_dir():
                return "This task has no workspace any more."
            show_diff(self.web, conv, ws, text.strip() or f"origin/{base_branch()}")
            return "Code tab updated."
        self.forward(conv, user, f"ran {command} {text}".strip(), raw=True)
        return ""

    def action(self, payload: dict) -> None:
        user = (payload.get("user") or {}).get("id")
        channel = (payload.get("channel") or {}).get("id") or payload.get("channel_id")
        reply_url = payload.get("response_url")
        for act in payload.get("actions") or []:
            action_id, value = act.get("action_id", ""), act.get("value", "")
            if action_id in ("approve", "approve_all", "deny"):
                if not self.owner(user):
                    respond(reply_url, {"response_type": "ephemeral", "replace_original": False,
                                        "text": f"Only {OWNER} can approve this."})
                    continue
                approved = action_id != "deny"
                write_json(APPROVALS / f"{value}.json", {"approved": approved, "by": self.display(user),
                                                         "all": action_id == "approve_all"})
                ask = read_json(APPROVALS / f"{value}.ask.json", {})
                what, after = ask.get("what", "the step"), ""
                if action_id == "approve_all" and ask.get("conv") and ask.get("kinds"):
                    kinds = read_json(conv_state(ask["conv"]), {}).get("approved_kinds") or []
                    update_state(ask["conv"], approved_kinds=sorted(set(kinds) | set(ask["kinds"])))
                    after = f"\nFrom now on in this task, without asking: {', '.join(ask['kinds'])}."
                respond(reply_url, {"replace_original": True,
                                    "text": f"{'Approved' if approved else 'Denied'} by {self.display(user)}: {what}{after}"})
                log("approval", value, action_id, self.display(user))
            elif action_id in ("hold_pass", "hold_drop"):
                held = read_json(APPROVALS / f"{value}.hold.json", None)
                if not self.owner(user) or not held:
                    respond(reply_url, {"response_type": "ephemeral", "replace_original": False,
                                        "text": f"Only {OWNER} can release a held message."})
                    continue
                passed = action_id == "hold_pass"
                respond(reply_url, {"replace_original": True, "text":
                                    f"{'Passed on' if passed else 'Dropped'} by {self.display(user)}: "
                                    f"a held message from {self.display(held['user'])}."})
                (APPROVALS / f"{value}.hold.json").unlink()
                log("hold", value, "passed" if passed else "dropped")
                if passed and self.conv_of(*split(held["conv"])):
                    self.forward(self.conv_of(*split(held["conv"])), held["user"],
                                 held["text"] + f" (held by the safety check, passed on by {OWNER})", ts=held["ts"])
            elif action_id.startswith("choose_"):
                choice, message = json.loads(value), payload.get("message") or {}
                conv = self.conv_of(*split(choice["conv"]))
                if not conv or user not in CONFIG["wakers"]:
                    respond(reply_url, {"response_type": "ephemeral", "replace_original": False,
                                        "text": "Only people who can wake the agent can answer."})
                    continue
                if message.get("ts") in self.answered:  # a second click before the buttons went away
                    continue
                self.answered.add(message.get("ts"))
                respond(reply_url, {"replace_original": True, "text": message.get("text", ""), "blocks": [
                    {"type": "markdown", "text": message.get("text", "")[:12000]},
                    {"type": "context", "elements": [{"type": "mrkdwn", "text":
                        f"*{self.display(user)}* chose *{choice['option'][:200]}*"}]}]})
                question = " ".join(message.get("text", "").split())[:200]
                self.forward(conv, user, f"chose \"{choice['option']}\" in answer to your question \"{question}\"", raw=True)
            elif action_id.startswith("ui_") and not act.get("url"):  # a link button only opens its link
                self.control(action_id, value, user, reply_url)
            elif action_id == "feedback":
                log("feedback", channel, self.display(user), value)
                respond(reply_url, {"response_type": "ephemeral", "replace_original": False,
                                    "text": "Thanks, noted."})
        # A context bar action click: its payload shape is not documented, so match loosely.
        if not payload.get("actions") and "finish" in json.dumps(payload) and self.conv_of(channel, None):
            self.command(channel, user, "/done", "")

    def control(self, action_id: str, channel: str, user: str | None, reply_url: str | None) -> None:
        conv = self.conv_of(channel, None)
        if not conv or user not in CONFIG["wakers"]:
            respond(reply_url, {"response_type": "ephemeral", "replace_original": False,
                                "text": "Only people who can wake the agent may use these controls."})
            return
        log("control", action_id, conv, self.display(user))
        if action_id == "ui_finish":
            reply = self.command(channel, user, "/done", "")
            if reply:
                respond(reply_url, {"response_type": "ephemeral", "replace_original": False, "text": reply})
        elif action_id == "ui_compact":
            handle = self.sessions[conv].get(HANDLE)
            if T3:
                if handle:
                    t3_send(handle, "/compact", mode="queue")  # after the running turn, as typed into a busy terminal
            elif handle and orca("terminal", "send", "--terminal", handle, "--text", "/compact").get("ok"):
                orca("terminal", "send", "--terminal", handle, "--enter")
        else:
            what = {"ui_tests": "pressed Run tests: run the tests your change touches",
                    "ui_pr": "pressed Push & PR: push the branch and open a pull request"}[action_id]
            self.forward(conv, user, what, raw=True)

    # --- sessions -------------------------------------------------------------------------

    def start(self, conv: str, user: str, text: str, origin: str, ts: str) -> None:
        if not text:
            return
        channel, thread = split(conv)
        if CONFIG["usage_check"] and subprocess.run(CONFIG["usage_check"], capture_output=True).returncode == 1:
            post(self.web, conv, "The weekly Claude limit is nearly spent, so I start no new session.")
            return
        try:
            self.web.reactions_add(channel=origin, timestamp=ts, name="eyes")
        except SlackApiError:
            pass
        name = slug(text)
        # Registered before the slow steps, so a message meanwhile is not a new task.
        self.sessions[conv] = {"conv": conv, "name": name, "origin": origin, "ts": ts,
                               "started": time.time(), "starting": True, "initiator": user}
        set_status(self.web, conv, "processing", title=text.splitlines()[0][:80])
        workspace, branch = self.workspace(conv, name)
        if not workspace:
            del self.sessions[conv]
            set_status(self.web, conv, "active")
            return
        self.sessions[conv].update(workspace=workspace, branch=branch)
        update_state(conv, workspace=workspace, branch=branch, initiator=user, team=self.team, request_ts=ts)
        if not thread:
            setup_code_channel(self.web, channel, workspace, branch)
        link = self.web.chat_getPermalink(channel=origin, message_ts=ts).get("permalink", f"{origin} {ts}")
        where = ("a code channel" if not thread else
                 f"a session thread under the request (channel {channel}, thread {thread})")
        system = system_prompt(conv=conv, where=where, decide=DECIDE.format(conv=conv) if thread else "",
                               workspace=workspace, branch=branch)
        task = TASK.format(who=self.display(user), text=text, origin_link=link,
                           read=TASK_READ.format(origin=origin, ts=ts))
        self.sessions[conv]["seen"] = ts
        self.sessions[conv][HANDLE] = self.launch(conv, system, task)
        del self.sessions[conv]["starting"]
        self.save()
        log("started", conv, name, self.sessions[conv][HANDLE])

    def workspace(self, conv: str, name: str) -> tuple[str | None, str | None]:
        # A task starts from the newest default branch on origin, not from the checkout's local one.
        repo = ["git", "-C", str(Path(CONFIG["repo"]).expanduser())]
        subprocess.run([*repo, "remote", "set-head", "origin", "--auto"], capture_output=True)
        base = base_branch()
        subprocess.run([*repo, "fetch", "-q", "origin", base], capture_output=True)
        if T3:
            # An idle thread in a new worktree; launch() gives it the agent's files, then the task.
            res = t3_launch(f"slack {name}", {"type": "worktree", "branch": name, "baseRef": base,
                                              "startFromOrigin": True})
            if res.get("error"):
                log("workspace failed", conv, res)
                post(self.web, conv, f"Could not make a workspace: {res['error']}")
                return None, None
            self.sessions[conv]["new_thread"] = res["thread"]
            return res["path"], res["branch"]
        res = orca("worktree", "create", "--repo", f'path:{CONFIG["repo"]}', "--name", name,
                   "--parent-worktree", f'path:{CONFIG["workspace"]}', "--setup", "skip", "--base-branch", f"origin/{base}",
                   "--comment", f"Slack task {name} ({conv}), started by slack-agent")
        wt = (res.get("result") or {}).get("worktree") or {}
        if not wt.get("path"):
            log("workspace failed", conv, res)
            post(self.web, conv, f"Could not make a workspace: {res.get('error')}")
            return None, None
        close_seeded_terminals(wt["path"])
        return wt["path"], wt.get("branch", "").removeprefix("refs/heads/")

    def launch(self, conv: str, system: str, task: str) -> str | None:
        s = self.sessions[conv]
        if T3:
            return self.launch_t3(conv, system, task)
        system_file, prompt_file = STATE_DIR / f"{conv}.system.md", STATE_DIR / f"{conv}.prompt.md"
        system_file.write_text(system)
        prompt_file.write_text(task)
        hook = {"permissions": {"deny": DENIED_TOOLS}, "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [
            {"type": "command", "command": f"{ENV} {shlex.quote(str(SELF))} gate", "timeout": APPROVAL_WAIT_S + 60}]}]}}
        settings = STATE_DIR / "claude-settings.json"
        write_json(settings, hook)
        args = " ".join(CONFIG["claude_args"])
        agent = " ".join(shlex.quote(a) for a in AGENT)
        command = (f'SLACK_AGENT_CONV={conv} {ENV} {agent} {args} --settings {shlex.quote(str(settings))} '
                   f'--append-system-prompt-file {shlex.quote(str(system_file))} "$(cat {shlex.quote(str(prompt_file))})"')
        res = orca("terminal", "create", "--worktree", f'path:{s["workspace"]}',
                   "--title", f"slack {s['name']}", "--command", command)
        handle = (res.get("result") or {}).get("terminal", {}).get("handle")
        if not handle:
            log("launch failed", conv, res)
            post(self.web, conv, f"Could not start Claude: {res.get('error')}")
        return handle

    def launch_t3(self, conv: str, system: str, task: str) -> str | None:
        """Give the task's thread its files and the task. A relaunch makes a new thread in the same worktree."""
        s = self.sessions[conv]
        write_agent_files(s["workspace"], conv, system)
        thread = s.pop("new_thread", None)
        if not thread:
            res = t3_launch(f"slack {s['name']}", {"type": "existing_worktree", "worktreePath": s["workspace"]})
            thread = res.get("thread")
            if not thread:
                log("launch failed", conv, res)
                post(self.web, conv, f"Could not start the agent in T3: {res.get('error')}")
                return None
        if not t3_send(thread, task):
            post(self.web, conv, f"Could not give the task to T3 thread {thread}; see the listener log.")
            return None
        return thread

    def on_message(self, conv: str, user: str, raw: str, text: str, ts: str) -> None:
        s = self.sessions[conv]
        if not text or s.get("starting"):
            return
        if text.startswith("!close") and self.owner(user):
            return self.close(conv, "Task closed.")
        if not self.owner(user) and user not in s.setdefault("others", []):
            s["others"].append(user)  # from now on the conversation is a group one
            self.save()
        wake, why = self.decide(conv, user, raw, text, ts)
        log("wake" if wake else "skip", conv, self.display(user), why)
        if wake:
            self.forward(conv, user, text, ts=ts, unsure=why.endswith("said maybe"))

    def decide(self, conv: str, user: str, raw: str, text: str, ts: str) -> tuple[bool, str]:
        if user not in CONFIG["wakers"]:
            return False, "not allowed to wake the agent"
        mentions = set(re.findall(r"<@(U[A-Z0-9]+)>", raw))
        owner = bool(self.owner(user))
        people = mentions - {self.bot_user}
        if owner and (self.bot_user in mentions or not (people or self.sessions[conv].get("others"))):
            return True, f"{OWNER}: mentions the agent" if mentions else f"only {OWNER} and the agent so far"
        # Everything else goes through the screen, which reads what the message says. A message that
        # tags a person may still ask the agent for something ("@Ann merges it, send me the link"):
        # 2026-11-03 such a message was dropped by a rule in code and never reached the agent.
        context = "\n".join(f"{self.display(m.get('user'))}: {self.named(m.get('text', ''))[:300]}"
                            for m in self.history(conv, None, before=ts)[-8:])
        question = (f"Conversation so far:\n{context}\n\n"
                    f"New message from {self.display(user)}: {self.named(text)[:1500]}")
        try:
            out = subprocess.run([*AGENT, *CLASSIFIER_ARGS, question],
                                 stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
            answer, problem = out.stdout.strip().lower(), out.stderr.strip()
        except subprocess.TimeoutExpired:
            answer, problem = "", "timed out"
        if owner and answer.startswith(("agent", "unsafe", "unrelated")):
            # An owner may ask the agent for anything, its own rules included: the answer only
            # tells whether the message is addressed to the agent.
            return True, f"{OWNER}: classifier said {answer.split(':')[0]}"
        if answer.startswith(("unsafe", "unrelated")):
            kind, _, why = answer.partition(":")
            reason = (f"it is not about the project ({why.strip()})" if kind == "unrelated"
                      else why.strip() or "it looks unsafe")
            self.hold(conv, user, text, ts, reason)
            return False, f"held: {answer[:80]}"
        if answer.startswith(("agent", "maybe", "other")):
            woken = answer.startswith(("agent", "maybe")) or self.bot_user in mentions
            return woken, f"classifier said {answer.split()[0]}"
        if not owner:
            self.hold(conv, user, text, ts, "the safety check failed")
            return False, f"held: classifier failed ({(problem or answer)[:60]!r})"
        # An owner's own message is not dropped because the check failed.
        return True, f"classifier failed ({(problem or answer)[:80]!r}), waking to be safe"

    def hold(self, conv: str, user: str, text: str, ts: str, reason: str) -> None:
        hold_id = uuid.uuid4().hex[:12]
        write_json(APPROVALS / f"{hold_id}.hold.json", {"conv": conv, "user": user, "text": text, "ts": ts})
        owners = " ".join(f"<@{u}>" for u in CONFIG["owners"])
        blocks = [{"type": "section", "text": {"type": "mrkdwn", "text":
                   f":warning: Held for {owners}: a message from {self.display(user)} did not go to the agent: {reason}."}},
                  {"type": "actions", "elements": [
                      {"type": "button", "text": {"type": "plain_text", "text": "Pass it on"}, "action_id": "hold_pass", "value": hold_id},
                      {"type": "button", "text": {"type": "plain_text", "text": "Drop"}, "action_id": "hold_drop",
                       "value": hold_id, "style": "danger"}]}]
        post(self.web, conv, f"Held for {OWNER}: {reason}", blocks=blocks)

    def history(self, conv: str, oldest: str | None, before: str | None = None) -> list[dict]:
        """People's messages in the conversation, oldest first, from Slack's own record."""
        channel, thread = split(conv)
        args = {"channel": channel, "limit": 100}
        if oldest:
            args["oldest"] = oldest
        if before:
            args["latest"] = before
        try:
            data = (self.web.conversations_replies(ts=thread, **args) if thread
                    else self.web.conversations_history(**args))
        except SlackApiError as exc:
            log("history failed", conv, exc.response.get("error"))
            return []
        msgs = [m for m in data.get("messages", []) if m.get("user") and not m.get("bot_id")
                and not m.get("subtype") and m.get("ts") not in (oldest, before) and not SEED.match(m.get("text", ""))]
        return sorted(msgs, key=lambda m: float(m["ts"]))

    def forward(self, conv: str, user: str, text: str, raw: bool = False, ts: str | None = None,
                unsure: bool = False) -> None:
        s = self.sessions[conv]
        if not text or s.get("starting"):
            return
        digest = ""
        if s.get("seen"):
            missed = self.history(conv, s["seen"], before=ts)
            if missed:
                lines = "; ".join(f"{self.display(m.get('user'))}: {m.get('text', '')}" for m in missed).replace("\n", " ")
                if len(lines) > DIGEST_CHARS:
                    how = (f"slack_read_channel / slack_read_thread after {s['seen']}" if CONNECTOR else
                           f"`slack-agent read {conv} --after {s['seen']}" + (f" --before {ts}`" if ts else "`"))
                    lines = f"{len(missed)} messages; read them with {how}"
                digest = f" ⏎ ⏎ [context only, said before it and not to you: {lines}]"
        if ts:
            s["seen"] = ts
            try:
                self.web.reactions_add(channel=split(conv)[0], timestamp=ts, name="ear")
            except SlackApiError:
                pass
        line = (f"[slack] {self.display(user)}" + (" (maybe not to you)" if unsure else "")
                + (" " if raw else ": ") + text.replace("\n", " ⏎ ") + digest)
        handle = s.get(HANDLE)
        if T3:
            # A thread whose last turn failed takes the message too: T3 resumes its session in a new turn.
            delivered = bool(handle) and t3_thread(handle) is not None and t3_send(handle, line)
        else:
            delivered = bool(handle) and orca("terminal", "send", "--terminal", handle, "--text", line).get("ok")
            if delivered:
                orca("terminal", "send", "--terminal", handle, "--enter")
        if delivered:
            set_status(self.web, conv, "processing")
            s["last"] = time.time()
            self.save()
            log("forwarded", conv, self.display(user))
            return
        if not self.owner(user):
            return
        # The Claude tab (or the T3 thread) is gone: start a new session that carries the message.
        system = system_prompt(conv=conv, where="the same conversation as before", decide="",
                               workspace=s["workspace"], branch=s["branch"])
        how = "the Slack connector" if CONNECTOR else f"`slack-agent read {conv}`"
        task = TASK.format(who=self.display(user), origin_link=f'{s["origin"]} {s["ts"]}',
                           read=TASK_READ.format(origin=s["origin"], ts=s["ts"]),
                           text=text + f"\n\n(The earlier Claude session of this conversation ended; "
                                       f"read its history with {how} if you need it.)")
        if T3 and handle:
            t3("t3_thread_organize", {"threadId": handle, "action": "archive"})
        s[HANDLE] = self.launch(conv, system, task)
        set_status(self.web, conv, "processing")
        self.save()
        log("relaunched", conv, s[HANDLE])

    def close(self, conv: str, text: str) -> None:
        channel, thread = split(conv)
        post(self.web, conv, text)
        if thread:
            set_status(self.web, conv, "closed")
            self.cleanup(conv)
        else:
            self.web.api_call("agents.conversations.archive", json={"channel_id": channel})  # channel_archive cleans up

    def stop(self, event: dict) -> None:
        conv = self.conv_of(event.get("channel"), event.get("thread_ts"))
        s = self.sessions.get(conv or "")
        if not s or not s.get(HANDLE):
            return
        if T3:
            t3("t3_thread_interrupt", {"threadId": s[HANDLE], "reason": "stopped from Slack"})
        else:
            orca("terminal", "send", "--terminal", s["terminal"], "--text", "\x1b")
        end_stream(self.web, conv, "active")  # a plan left streaming would end as "Something went wrong"
        set_status(self.web, conv, "active")
        post(self.web, conv, f"Stopped by {self.display(event.get('user'))}. Send a message to go on.")
        log("stopped", conv)

    def cleanup(self, conv: str | None) -> None:
        s = self.sessions.pop(conv, None) if conv else None
        if not s:
            return
        self.save()
        had_preview = bool(read_json(conv_state(conv), {}).get("preview"))
        preview_stop(conv)
        if had_preview:
            preview_restore(self.web, conv)
        for c in {conv, s.get("thread_conv") or conv}:  # a moved session also has its thread's files
            for suffix in (".json", ".prompt.md", ".system.md", "-preview.log"):
                (STATE_DIR / f"{c}{suffix}").unlink(missing_ok=True)
        if s.get("terminal"):
            orca("terminal", "close", "--terminal", s["terminal"])
        if s.get("thread"):
            t3("t3_thread_interrupt", {"threadId": s["thread"], "reason": "the Slack task ended"})
            t3("t3_thread_organize", {"threadId": s["thread"], "action": "archive"})
        ws = s.get("workspace")
        if not ws or Path(ws) == Path(CONFIG["workspace"]):
            return
        git = lambda *a: subprocess.run(["git", "-C", ws, *a], capture_output=True, text=True).stdout.strip()
        unpushed = (git("log", "--oneline", "@{upstream}..HEAD") if git("rev-parse", "--abbrev-ref", "@{upstream}")
                    else git("log", "--oneline", f"origin/{base_branch()}..HEAD"))
        if unpushed or git("status", "--porcelain"):
            self.web.chat_postMessage(channel=s["origin"], thread_ts=s["ts"],
                                      text=f"Task {s['name']} is closed. I kept its workspace `{ws}`: "
                                           "its branch has work that is not pushed.")
            log("closed, kept", conv, ws)
        elif T3:
            if CONFIG["cleanup_command"]:  # the repo's own cleanup, before its workspace goes
                try:
                    done = subprocess.run(CONFIG["cleanup_command"], shell=True, cwd=ws, capture_output=True,
                                          text=True, timeout=600)
                    log("cleanup command", conv, done.returncode, (done.stdout + done.stderr).strip()[-300:])
                except subprocess.TimeoutExpired:
                    log("cleanup command timed out", conv)
            repo = ["git", "-C", CONFIG["repo"]]
            removed = subprocess.run([*repo, "worktree", "remove", "--force", ws], capture_output=True, text=True)
            if s.get("branch"):
                subprocess.run([*repo, "branch", "-D", s["branch"]], capture_output=True)
            log("closed, removed", conv, ws, removed.stderr.strip()[:200])
        else:
            orca("worktree", "rm", "--worktree", f"path:{ws}")
            log("closed, removed", conv, ws)

    def housekeeping(self) -> None:
        while True:
            time.sleep(30)
            with self.lock:
                for conv in list(self.sessions):
                    s, state = self.sessions[conv], read_json(conv_state(conv), {})
                    try:
                        if state.get("finished"):
                            self.cleanup(conv)  # a session thread `finish` closed
                        elif state.get("status") == "processing" and time.time() - state.get("status_at", 0) > KEEPALIVE_S:
                            set_status(self.web, conv, "processing")
                        elif "-" in conv and time.time() - max(s.get("last", 0), state.get("status_at", 0)) > IDLE_THREAD_S:
                            self.close(conv, "Closing this thread after a day without messages.")
                    except SlackApiError as exc:
                        log("housekeeping failed", conv, exc.response.get("error"))


    def watch_work(self) -> None:
        """Keep each code channel's Code tab and PR link current from its workspace, whatever agent works there."""
        checked: dict[str, tuple[str, float]] = {}
        t3_checked = 0.0
        while True:
            time.sleep(WATCH_S)
            if T3 and time.time() - t3_checked > T3_CHECK_S:
                t3_checked = time.time()
                try:
                    self.watch_threads()
                except Exception as exc:
                    log("thread watch failed", repr(exc))
            for conv, session in list(self.sessions.items()):
                channel, thread = split(read_json(conv_state(conv), {}).get("moved_to") or conv)
                ws = session.get("workspace")
                if thread or not ws or not Path(ws).is_dir():
                    continue
                try:
                    show_diff(self.web, channel, ws, changed_only=True)
                    upstream = subprocess.run(["git", "-C", ws, "rev-parse", "@{u}"], capture_output=True, text=True).stdout
                    # GitHub is asked again when the pushed branch moved, or after PR_CHECK_S (a PR opens without a push).
                    last = checked.get(channel)
                    if last and last[0] == upstream and time.time() - last[1] < PR_CHECK_S:
                        continue
                    checked[channel] = (upstream, time.time())
                    pr = branch_pr(ws)
                    if pr != read_json(conv_state(channel), {}).get("pr"):
                        update_state(channel, pr=pr)
                        if CONFIG["test_ui"]:
                            publish_controls(self.web, channel)
                except Exception as exc:  # one broken workspace must not stop the watch
                    log("watch failed", conv, repr(exc))


    def watch_threads(self) -> None:
        """Say in Slack when a task's T3 turn failed: the agent cannot say it, and the session would
        stay "processing" with nothing behind it."""
        mine = {s.get("thread"): conv for conv, s in self.sessions.items() if s.get("thread")}
        if not mine:
            return
        listed = t3("t3_thread_list", {"projectId": t3_project(), "statuses": ["failed"], "limit": 100})
        for thread in listed.get("threads", []):
            conv = mine.get(thread.get("threadId"))
            run = thread.get("latestRunId")
            if not conv or self.sessions[conv].get("failed_run") == run:
                continue
            with self.lock:
                self.sessions[conv]["failed_run"] = run
                self.save()
                to = read_json(conv_state(conv), {}).get("moved_to") or conv
                end_stream(self.web, to, "active")
                set_status(self.web, to, "active")
                post(self.web, to, "The agent's turn failed in T3 Code. Send a message to go on.")
            log("thread failed", conv, thread.get("threadId"), run)


def respond(url: str | None, body: dict) -> None:
    if url:
        urllib.request.urlopen(urllib.request.Request(url, data=json.dumps(body).encode(),
                                                      headers={"Content-Type": "application/json"}))


def listen() -> None:
    from slack_sdk.socket_mode import SocketModeClient
    from slack_sdk.socket_mode.request import SocketModeRequest
    from slack_sdk.socket_mode.response import SocketModeResponse

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock = (STATE_DIR / "listener.lock").open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit("slack-agent: another listener is running")
    # `kill -USR1 <pid>` writes every thread's stack here, to see where a stuck listener waits.
    faulthandler.register(signal.SIGUSR1, file=(STATE_DIR / "stacks.txt").open("w"), all_threads=True)
    bot = Listener()
    sdk_log = logging.FileHandler(LOG)
    sdk_log.setFormatter(logging.Formatter("%(asctime)s socket %(levelname)s %(message)s", "%Y-%m-%d %H:%M:%S"))
    logging.getLogger("slack_sdk.socket_mode").addHandler(sdk_log)
    logging.getLogger("slack_sdk.socket_mode").setLevel(logging.WARNING)
    client = SocketModeClient(app_token=secret("app"), web_client=bot.web)

    def on_request(c: SocketModeClient, req: SocketModeRequest) -> None:
        if req.type == "slash_commands":
            p = req.payload
            log("command", p.get("command"), repr(p.get("text", ""))[:80], p.get("channel_id"))
            with bot.lock:
                try:
                    reply = bot.command(p.get("channel_id"), p.get("user_id"), p.get("command"), p.get("text", ""))
                except Exception as exc:  # one bad command must not stop the listener
                    log("error", p.get("command"), repr(exc))
                    reply = "Something went wrong; see the listener log."
            c.send_socket_mode_response(SocketModeResponse(envelope_id=req.envelope_id))
            # A code channel shows nothing for a reply in the ack, so post it apart, visible to the sender only.
            if reply:
                bot.web.chat_postEphemeral(channel=p.get("channel_id"), user=p.get("user_id"), text=reply)
            return
        c.send_socket_mode_response(SocketModeResponse(envelope_id=req.envelope_id))
        e = req.payload.get("event", {}) if req.type == "events_api" else {}
        if e.get("type") == "app_mention":  # logged on arrival, so a tag that does nothing shows here
            log("mention", e.get("channel"), e.get("user"), e.get("ts"))
        with bot.lock:
            try:
                if req.type == "interactive":
                    log("interactive", req.payload.get("type"), json.dumps(req.payload.get("actions") or req.payload)[:300])
                    bot.action(req.payload)
                elif req.type == "events_api":
                    bot.handle(req.payload.get("event", {}))
            except Exception as exc:  # one bad event must not stop the listener
                log("error", req.type, repr(exc))

    client.socket_mode_request_listeners.append(on_request)
    client.connect()
    threading.Thread(target=bot.housekeeping, daemon=True).start()
    threading.Thread(target=bot.watch_work, daemon=True).start()
    if CONFIG["test_ui"]:
        threading.Thread(target=serve_test_ui, daemon=True).start()
    log("listening as", bot.bot_user, "workspace", CONFIG["workspace"], "backend", CONFIG["backend"])
    if T3 and not t3_project():
        log("no T3 project has the folder", CONFIG["repo"], "- tasks cannot start; add it with `t3 project add`")
    down_since = None
    while True:
        time.sleep(30)
        if client.is_connected():
            down_since = None
        elif down_since is None:
            down_since = time.time()
        elif time.time() - down_since > RECONNECT_S:
            # The SDK's own reconnect can stall for good after the laptop sleeps; a new process connects.
            log("socket down", int(time.time() - down_since), "s, restarting the listener")
            os.execv(sys.executable, [sys.executable, *sys.argv])


# --- helpers for the Claude sessions --------------------------------------------------------

def ask_blocks(conv: str, question: str, options: list[str]) -> list[dict]:
    return [{"type": "markdown", "text": question[:12000]},
            {"type": "actions", "elements": [
                {"type": "button", "text": {"type": "plain_text", "text": option[:75]}, "action_id": f"choose_{i}",
                 "value": json.dumps({"conv": conv, "option": option[:1500]})} for i, option in enumerate(options)]}]


def approve(web: WebClient, conv: str, what: str, why: str | None = None, command: str | None = None,
            kinds: list[str] | None = None) -> bool:
    """Ask an owner with Approve/Deny buttons; True once one approves. With `kinds` (a gated
    command's kinds of step) a third button approves it and every later step of those kinds in
    this task."""
    ask_id = uuid.uuid4().hex[:12]
    write_json(APPROVALS / f"{ask_id}.ask.json", {"conv": conv, "what": what, "kinds": kinds or []})
    blocks = [{"type": "section", "text": {"type": "mrkdwn", "text": f"*Approval needed ({OWNER}):* {what[:2800]}"}}]
    if why:
        blocks.append({"type": "context", "elements": [{"type": "mrkdwn", "text": f"Why: {why[:2900]}"}]})
    if command:
        shown = command if len(command) <= 2800 else command[:2800] + f"\n… ({len(command) - 2800} more characters)"
        blocks.append({"type": "section", "text": {"type": "mrkdwn",
                                                   "text": "```" + shown.replace("```", "`\u200b``") + "```"}})
    buttons = [{"type": "button", "text": {"type": "plain_text", "text": "Approve"}, "style": "primary",
                "action_id": "approve", "value": ask_id}]
    if kinds:
        buttons.append({"type": "button", "text": {"type": "plain_text", "text": "Approve all like this in this task"},
                        "action_id": "approve_all", "value": ask_id})
    buttons.append({"type": "button", "text": {"type": "plain_text", "text": "Deny"}, "style": "danger",
                    "action_id": "deny", "value": ask_id})
    blocks.append({"type": "actions", "elements": buttons})
    post(web, conv, f"Approval needed: {what}", blocks=blocks)
    set_status(web, conv, "suspended")
    deadline = time.time() + APPROVAL_WAIT_S
    while time.time() < deadline:
        decision = read_json(APPROVALS / f"{ask_id}.json", None)
        if decision is not None:
            set_status(web, conv, "processing")
            return bool(decision["approved"])
        time.sleep(2)
    post(web, conv, "No answer in 30 minutes, so I did not do it.")
    return False


def step(web: WebClient, conv: str, task_id: str, status: str, title: str, details: str | None) -> None:
    channel, thread = split(conv)
    state = read_json(conv_state(conv), {})
    chunk = {"type": "task_update", "id": task_id, "title": title, "status": status}
    if details:
        chunk["details"] = details
    stream = state.get("stream") or {}
    if stream and time.time() - stream["at"] < STREAM_S:
        try:
            web.api_call("chat.appendStream", json={"channel": channel, "ts": stream["ts"], "chunks": [chunk]})
            stream.setdefault("tasks", {})[task_id] = {"title": title, "status": status}
            update_state(conv, stream=stream)
            return
        except SlackApiError as exc:
            log("appendStream failed", conv, exc.response.get("error"))
    elif stream:
        end_stream(web, conv)  # Slack ends a stream after 10 minutes: close it and start a new one
    body = {"channel": channel, "task_display_mode": "plan", "chunks": [chunk],
            "recipient_user_id": state.get("initiator"), "recipient_team_id": state.get("team")}
    if thread:
        body["thread_ts"] = thread
    ts = web.api_call("chat.startStream", json=body)["ts"]
    update_state(conv, stream={"ts": ts, "at": time.time(), "tasks": {task_id: {"title": title, "status": status}}})


def end_stream(web: WebClient, conv: str, status: str = "processing") -> None:
    stream = read_json(conv_state(conv), {}).get("stream")
    if not stream:
        return
    # A plan closed with a step still open shows "Something went wrong": close the open steps.
    open_steps = [{"type": "task_update", "id": k, "title": t["title"], "status": "complete",
                   "details": "Not done: the work went another way."}
                  for k, t in (stream.get("tasks") or {}).items() if t["status"] in ("pending", "in_progress")]
    try:
        if open_steps:
            web.api_call("chat.appendStream", json={"channel": split(conv)[0], "ts": stream["ts"], "chunks": open_steps})
        web.api_call("chat.stopStream", json={"channel": split(conv)[0], "ts": stream["ts"],
                                              "session_status": status})
    except SlackApiError:
        pass  # finalized already
    update_state(conv, stream=None)


def open_channel(web: WebClient, conv: str, title: str) -> str:
    channel, thread = split(conv)
    state = read_json(conv_state(conv), {})
    created = web.api_call("agents.conversations.create", json={
        "name": title[:80], "session_id": hashlib.sha1(conv.encode()).hexdigest()[:24],
        # Slack adds the author of the origin message: the request, not the thread's parent by someone else.
        "origin_channel_id": channel, "origin_message_ts": state.get("request_ts") or thread})["channel_id"]
    update_state(conv, moved_to=created)
    write_json(conv_state(created), {k: state[k] for k in ("workspace", "branch", "initiator", "team") if k in state})
    set_status(web, created, "processing")
    setup_code_channel(web, created, state.get("workspace", os.getcwd()), state.get("branch", ""))
    set_status(web, conv, "closed")
    return created


def replace_diff(web: WebClient, channel: str, view: dict) -> None:
    try:
        print(web.api_call("agents.conversations.setView", json=view).data)
    except SlackApiError as exc:
        if exc.response.get("error") != "too_many_views":
            raise
        # A channel holds one diff view: replace it.
        views = web.api_call("agents.conversations.listViews", json={"channel_id": channel}).data
        for v in views.get("session_views", []) + views.get("views", []):
            if v.get("type") == "diff":
                web.api_call("agents.conversations.removeView", json={"channel_id": channel, "view_id": v["view_id"]})
        print(web.api_call("agents.conversations.setView", json=view).data)


def show_diff(web: WebClient, channel: str, cwd: str, base: str = "", changed_only: bool = False) -> bool:
    """Put `git diff` of `cwd` against its merge base with `base` in the channel's Code tab. With
    `changed_only`, skip an upload when the diff is the one the tab already shows."""
    git = ["git", "-C", cwd]
    base = base or f"origin/{base_branch()}"
    merge_base = subprocess.run([*git, "merge-base", base, "HEAD"], capture_output=True, text=True,
                                check=True).stdout.strip()
    diff = subprocess.run([*git, "diff", merge_base], capture_output=True, text=True, check=True).stdout
    digest = hashlib.sha1(f"{base}\0{diff}".encode()).hexdigest()
    if changed_only and read_json(conv_state(channel), {}).get("diff_digest") == digest:
        return False
    branch = subprocess.run([*git, "branch", "--show-current"], capture_output=True, text=True).stdout.strip()
    replace_diff(web, channel, {"channel_id": channel, "type": "diff", "content": diff or "(no changes)",
                                "base_branch": base, "head_branch": branch or "HEAD"})
    update_state(channel, diff_digest=digest)
    return True


def branch_pr(ws: str) -> dict | None:
    """The open pull request of the workspace's branch; none before the branch is pushed."""
    if subprocess.run(["git", "-C", ws, "rev-parse", "@{u}"], capture_output=True).returncode:
        return None
    out = subprocess.run(["gh", "pr", "view", "--json", "number,url,state"], cwd=ws, capture_output=True, text=True)
    pr = json.loads(out.stdout) if out.returncode == 0 else None
    return {"number": pr["number"], "url": pr["url"]} if pr and pr["state"] == "OPEN" else None


def read(web: WebClient, args: list[str], channel: str, thread: str | None) -> None:
    """Print a channel's (or a thread's) messages, oldest first, as the bot sees them."""
    opts, it = {"limit": "50"}, iter(args)
    for arg in it:
        if arg in ("--after", "--before", "--limit"):
            opts[arg[2:]] = next(it, "")
        elif not thread and re.fullmatch(r"\d+\.\d+", arg):
            thread = arg
        else:
            sys.exit(f"slack-agent read: unknown argument {arg!r}")
    if not channel_allowed(channel):
        sys.exit(f"slack-agent read: {channel} is not a channel this bot works in (the config's `channels`)")
    query = {"channel": channel, "limit": max(1, min(int(opts["limit"] or 50), 200))}
    if opts.get("after"):
        query["oldest"] = opts["after"]
    if opts.get("before"):
        query["latest"] = opts["before"]
    try:
        data = web.conversations_replies(ts=thread, **query) if thread else web.conversations_history(**query)
    except SlackApiError as exc:
        sys.exit(f"slack-agent read: Slack said {exc.response.get('error')}")
    names: dict[str, str] = {}

    def name(user: str | None, bot: str | None = None) -> str:
        if bot or not user:
            return CONFIG["bot_name"] if bot else "?"
        if user not in names:
            try:
                p = web.users_info(user=user)["user"]
                names[user] = CONFIG["owners"].get(user) or p.get("real_name") or p.get("name") or user
            except SlackApiError:
                names[user] = user
        return names[user]

    edge = {opts.get("after"), opts.get("before")} - {None, ""}
    msgs = sorted((m for m in data.get("messages", []) if m.get("ts") not in edge), key=lambda m: float(m["ts"]))
    for m in msgs:
        text = re.sub(r"<@(U[A-Z0-9]+)(?:\|[^>]*)?>", lambda g: "@" + name(g.group(1)), m.get("text", ""))
        files = "".join(f" [file: {f.get('name') or f.get('title') or f.get('id')}]" for f in m.get("files", []))
        replies = (f" [thread {m['ts']}, {m['reply_count']} replies]"
                   if m.get("reply_count") and not thread else "")
        print(f"{m['ts']} {name(m.get('user'), m.get('bot_id'))}: {text}{files}{replies}")
    if data.get("has_more") and msgs:
        # A thread comes oldest first, so the rest is newer; a channel newest first, so the rest is older.
        print(f"(more: --after {msgs[-1]['ts']})" if thread else f"(more, older: --before {msgs[0]['ts']})")


def gate() -> None:
    """PreToolUse hook: a risky shell command waits for an owner's Approve click."""
    event = json.loads(sys.stdin.read() or "{}")
    tool_input = event.get("tool_input") or {}
    command = tool_input.get("command", "")
    conv = os.environ.get("SLACK_AGENT_CONV")
    if not conv or not command:
        return
    if re.match(r"\s*(\S+/)?slack-agent\s+approve\b[^;|&]*&&", command):
        return  # the approve call in front of `&&` asks already
    first = read_json(conv_state(conv), {})
    # The session may have moved from its thread to a code channel since it started.
    conv = first.get("moved_to") or conv
    state = read_json(conv_state(conv), {}) if first.get("moved_to") else first
    steps = risky(command, event.get("cwd") or os.getcwd(), first.get("workspace") or state.get("workspace"))
    if not steps:
        return
    kinds = sorted({k for k, _ in steps})
    if set(kinds) <= set(state.get("approved_kinds") or []):
        log("gate: approved for this task already", conv, kinds)
        return
    what = "; ".join(f"{k}: {d}" if d else k for k, d in steps)
    if not approve(WebClient(token=secret("bot")), conv, what, why=tool_input.get("description"),
                   command=command, kinds=kinds):
        print(f"{OWNER} did not approve this command in Slack. Do not run it; ask them in the conversation.",
              file=sys.stderr)
        sys.exit(2)


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help"):
        sys.exit(__doc__)
    cmd, rest = argv[0], argv[1:]
    load_extensions()
    if cmd == "listen":
        return listen()
    if cmd == "gate":
        return gate()
    if cmd == "rotate":
        data = WebClient().api_call("tooling.tokens.rotate", params={"refresh_token": secret("config-refresh")}).data
        for name, key in (("config-access", "token"), ("config-refresh", "refresh_token")):
            store_secret(name, data[key])
        print("config token valid until", time.strftime("%Y-%m-%d %H:%M", time.localtime(data["exp"])))
        return
    web = WebClient(token=secret("bot"))
    conv = rest[0] if rest else ""
    channel, thread = split(conv)
    state = read_json(conv_state(conv), {}) if conv else {}
    if cmd in {"bar", "link", "diff", "html", "canvas", "plan", "comments"} and thread:
        sys.exit(f"`{cmd}` works in a code channel only; run `slack-agent open-channel {conv} <title>` first")
    if (cmd == "say" and len(rest) == 1) or (cmd == "ask" and 1 <= len(rest) <= 11):
        if cmd == "ask":
            end_stream(web, conv)
        text = sys.stdin.read().strip()
        post(web, conv, text, ask_blocks(conv, text, rest[1:]) if len(rest) > 1 else None)
        if cmd == "ask":
            set_status(web, conv, "suspended")
    elif cmd == "approve" and len(rest) == 2:
        end_stream(web, conv)
        ok = approve(web, conv, rest[1])
        print("approved" if ok else "denied")
        sys.exit(0 if ok else 1)
    elif cmd == "status" and len(rest) == 2:
        if rest[1] != "processing":
            end_stream(web, conv)
        set_status(web, conv, rest[1])
    elif cmd == "rename" and len(rest) == 2:
        body = {"channel_id": channel, "title": rest[1]}
        if thread:
            body["thread_ts"] = thread
        print(web.api_call("agents.sessions.rename", json=body).data)
    elif cmd == "step" and len(rest) in (4, 5):
        step(web, conv, rest[1], rest[2], rest[3], rest[4] if len(rest) == 5 else None)
    elif cmd == "open-channel" and len(rest) == 2:
        if not thread:
            sys.exit("this is a code channel already")
        print(open_channel(web, conv, rest[1]))
    elif cmd == "finish" and len(rest) == 1:
        end_stream(web, conv)
        feedback = [{"type": "context_actions", "elements": [{
            "type": "feedback_buttons", "action_id": "feedback",
            "positive_button": {"text": {"type": "plain_text", "text": "👍"}, "value": "positive"},
            "negative_button": {"text": {"type": "plain_text", "text": "👎"}, "value": "negative"}}]}]
        summary = sys.stdin.read().strip()
        ts = post(web, conv, summary, blocks=[{"type": "markdown", "text": summary[:12000]}, *feedback])
        set_status(web, conv, "closed")
        if thread:
            update_state(conv, finished=True)  # the listener closes the tab and the workspace
        else:
            print(web.api_call("agents.conversations.archive",
                               json={"channel_id": channel, "summary_message_ts": ts}).data)
    elif cmd == "preview" and len(rest) == 1:
        if not CONFIG["preview"]:
            sys.exit("slack-agent: no preview is set up in the config")
        print(preview_start(web, channel)["url"])
    elif cmd == "preview-stop" and len(rest) == 1:
        had_preview = bool(state.get("preview"))
        preview_stop(channel)
        if had_preview:
            preview_restore(web, channel)
    elif cmd == "test-ui" and len(rest) == 1:
        publish_test_ui(web, channel)
    elif cmd == "read" and rest:
        read(web, rest[1:], channel, thread)
    elif cmd == "file" and len(rest) in (2, 3):
        print(web.files_upload_v2(channel=channel, thread_ts=thread, file=rest[1],
                                  initial_comment=rest[2] if len(rest) == 3 else None).data.get("ok"))
    elif cmd == "bar" and len(rest) >= 3:
        items = [i for i in state.get("bar", []) if i["key"] != rest[2 if rest[1] == "--remove" else 1]]
        if rest[1] != "--remove":
            item = {"key": rest[1], "label": rest[2]}
            if len(rest) > 3 and rest[3]:
                item["url"] = rest[3]
            if len(rest) > 4:
                item["icon"] = rest[4]
            # New items go before the Finish action, which stays last.
            at = next((n for n, i in enumerate(items) if i.get("item_type") == "action"), len(items))
            items.insert(at, item)
        set_bar(web, channel, items)
    elif cmd == "link" and len(rest) >= 3:
        label = rest[2] if rest[1] == "--remove" else rest[1]
        links = [i for i in state.get("links", []) if i["label"] != label]
        if rest[1] != "--remove":
            links.append({"label": label, "url": rest[2], **({"note": rest[3]} if len(rest) > 3 else {})})
        update_state(channel, links=links)
        publish_controls(web, channel)
    elif cmd == "diff" and len(rest) in (1, 2):
        show_diff(web, channel, ".", rest[1] if len(rest) == 2 else "")
    elif cmd == "tab" and len(rest) == 3 and rest[1] == "--remove":
        views = web.api_call("agents.conversations.listViews", json={"channel_id": channel}).data
        gone = [v for v in views.get("session_views", []) + views.get("views", [])
                if rest[2] in (v.get("name"), v.get("view_key"))]
        for v in gone:
            try:
                web.api_call("agents.conversations.removeView", json={"channel_id": channel, "view_id": v["view_id"]})
            except SlackApiError as exc:
                if exc.response.get("error") != "view_not_found":
                    raise
                sys.exit(f"Slack cannot remove the tab {rest[2]!r}: its file is gone. Ask a person to remove it in Slack.")
            if v.get("type") == "canvas" and v.get("file_id"):  # the canvas goes after its tab, never before
                try:
                    web.api_call("canvases.delete", json={"canvas_id": v["file_id"]})
                except SlackApiError:
                    pass
        print(f"removed {len(gone)} tab(s)" if gone else f"no tab named {rest[2]!r}")
    elif cmd == "html" and len(rest) in (2, 3):
        path = Path(rest[1])
        print(web.api_call("agents.conversations.setView", json={
            "channel_id": channel, "type": "html", "view_key": path.stem,
            "name": rest[2] if len(rest) == 3 else path.stem, "content": path.read_text()}).data)
    elif cmd in ("canvas", "plan") and len(rest) in (2, 3):
        path = Path(rest[1])
        if cmd == "plan" and state.get("plan_canvas"):
            print(web.api_call("agents.conversations.setCanvasContent", json={
                "channel": channel, "canvas_id": state["plan_canvas"], "content": path.read_text()}).data)
            return
        title = "Plan" if cmd == "plan" else (rest[2] if len(rest) == 3 else path.stem)
        canvas = web.api_call("canvases.create", json={
            "title": title, "document_content": {"type": "markdown", "markdown": path.read_text()}}).data
        view = {"channel_id": channel, "type": "canvas", "view_key": "plan" if cmd == "plan" else path.stem,
                "name": title, "canvas_id": canvas["canvas_id"]}
        if cmd == "plan":
            # People comment on the plan; only the agent edits it.
            view["access_level"] = "comment"
            update_state(channel, plan_canvas=canvas["canvas_id"])
        print(web.api_call("agents.conversations.setView", json=view).data)
    elif cmd == "comments" and len(rest) == 1:
        if not state.get("plan_canvas"):
            sys.exit("no plan canvas in this channel yet")
        data = web.api_call("agents.conversations.getCanvas", json={
            "channel": channel, "canvas_id": state["plan_canvas"], "content_format": "markdown"}).data
        print(data.get("content", ""))
        for c in data.get("comments", []):
            print(f"\n[comment by {c.get('user')}] on {c.get('anchor_text') or c.get('section') or '?'}: {c.get('text')}")
    elif any(cmd in getattr(e, "COMMANDS", {}) for e in EXTENSIONS) and rest:
        next(e for e in EXTENSIONS if cmd in getattr(e, "COMMANDS", {})).COMMANDS[cmd](web, channel, rest[1:])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
