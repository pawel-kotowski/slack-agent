def free_port() -> int:
    import socket
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def preview_start(web: WebClient, channel: str) -> dict:
    """Run the task workspace's app with sign-in, publish it at ui_origin and post the login."""
    cfg = CONFIG["preview"]
    # One preview per ui_origin: a new one replaces this channel's old one (e.g. after the workspace
    # moved to another branch) and any other channel's, whose Controls tab then drops the stale link.
    for f in STATE_DIR.glob("*.json"):
        other = f.stem
        if read_json(f, {}).get("preview"):
            preview_stop(other)
            if other != channel:
                update_state(other, preview_displaced_by=channel, preview_displaced_at=time.time())
            if other != channel and CONFIG["test_ui"]:
                try:
                    publish_controls(web, other)
                except SlackApiError:
                    pass
    update_state(channel, preview_displaced_by=None)
    state = read_json(conv_state(channel), {})
    ws = Path(state["workspace"])
    db = "preview_" + re.sub(r"[^a-z0-9]", "_", ws.name.lower())
    subprocess.run(["docker", "exec", cfg["pg_container"], "createdb", "-U", "postgres", db], capture_output=True)
    password = uuid.uuid4().hex[:16]
    api, ui = free_port(), free_port()
    values = {"user": cfg["user"], "password": password, "db": db, "pg_port": cfg["pg_port"],
              "pg_password": secret("postgres"), "host": CONFIG["ui_origin"].split("//")[1].split(":")[0],
              "branch": state.get("branch", ""), "api": api, "ui": ui}
    env_file = STATE_DIR / f"{channel}.preview.env"
    env_file.write_text("".join(f"{k}={str(v).format(**values)}\n" for k, v in cfg["env"].items()))
    env_file.chmod(0o600)
    load = f"set -a; . {env_file}; set +a"
    marker = cfg.get("setup_marker", ".slack-agent-setup-done")
    setup = "" if not cfg.get("setup") or (ws / marker).exists() else f"{cfg['setup']} && touch {marker} && "
    cmd = f"{load}; {setup}{cfg['command'].format(**values)}"
    if T3:
        process, terms = start_detached(f"{channel}-preview", str(ws), cmd), []
    else:
        res = orca("terminal", "create", "--worktree", f"path:{ws}", "--title", "preview (signed in)", "--command", cmd)
        process, terms = None, [(res.get("result") or {}).get("terminal", {}).get("handle")]
    port = CONFIG["ui_origin"].rsplit(":", 1)[1]
    subprocess.run(["tailscale", "funnel", "--bg", f"--https={port}", "--set-path", "/", f"http://127.0.0.1:{ui}"],
                   capture_output=True)
    try:
        private = web.conversations_info(channel=channel)["channel"].get("is_private", True)
    except SlackApiError:
        private = False
    preview = {"url": CONFIG["ui_origin"] + "/", "user": cfg["user"], "password": password, "db": db,
               "api": api, "ui": ui, "terminals": terms, "process": process, "private": private}
    update_state(channel, preview=preview)
    if CONFIG["test_ui"]:
        # The link and login live in the Controls tab only: posted in the chat as well, they showed
        # up in three places (2026-11-03: the owner asked for them in Controls only).
        publish_controls(web, channel)
    else:
        # In a public channel anyone in the workspace can read the login, so it is sent privately there.
        login = "password below" if private else "password: `/preview-login`"
        post(web, channel, f"**Preview of this branch**\n{preview['url']}\nUser `{cfg['user']}` · {login} · up in a minute or two")
        if private:  # alone, so Copy text copies just the password
            web.chat_postMessage(channel=channel, text=password)
    for hook in hooks("preview_started"):
        hook(web, channel)
    log("preview started", channel, ws.name, f"ui {ui} api {api}")
    return preview


def preview_restore(web: WebClient, freed_by: str) -> None:
    """After `freed_by`'s preview stopped, start again the preview it displaced most recently."""
    waiting = []
    for f in STATE_DIR.glob("*.json"):
        st = read_json(f, {})
        if st.get("preview_displaced_by") == freed_by and st.get("workspace") and st.get("status") != "closed":
            waiting.append((st.get("preview_displaced_at") or 0, f.stem))
    if waiting:
        channel = max(waiting)[1]
        try:
            preview_start(web, channel)
            log("preview restored", channel, "after", freed_by)
        except Exception as exc:  # noqa: BLE001 — a restore must never break the cleanup
            log("preview restore failed", channel, exc)


def preview_stop(channel: str) -> None:
    preview = read_json(conv_state(channel), {}).get("preview")
    if not preview:
        return
    for handle in preview.get("terminals", []):
        if handle:
            orca("terminal", "close", "--terminal", handle)
    if preview.get("process"):
        stop_detached(preview["process"])
    # An app's start script may put its servers in sessions of their own, which a closed terminal does not reach.
    for p in (preview["api"], preview["ui"]):
        pids = subprocess.run(["lsof", "-t", f"-iTCP:{p}", "-sTCP:LISTEN"], capture_output=True, text=True).stdout.split()
        subprocess.run(["kill", *pids], capture_output=True) if pids else None
    port = CONFIG["ui_origin"].rsplit(":", 1)[1]
    subprocess.run(["tailscale", "funnel", f"--https={port}", "--set-path", "/", "off"], capture_output=True)
    subprocess.run(["docker", "exec", CONFIG["preview"]["pg_container"], "dropdb", "-U", "postgres", "--if-exists", preview["db"]],
                   capture_output=True)
    (STATE_DIR / f"{channel}.preview.env").unlink(missing_ok=True)
    update_state(channel, preview=None)
    log("preview stopped", channel)



def serve_test_ui() -> None:
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):  # noqa: N802
            extra = re.fullmatch(r"/s/([0-9a-f]{32})/([a-z0-9-]+)\.js(\?.*)?", self.path)
            m = extra or re.fullmatch(r"/s/([0-9a-f]{32})\.(json|js)(\?.*)?", self.path)
            channel = None
            if m:
                for f in STATE_DIR.glob("C*.json"):
                    if read_json(f, {}).get("ui_token") == m.group(1):
                        channel = f.stem
            if extra and channel:
                # An extension's data for its own part of the Live tab, as a script.
                found = [b for h in hooks("live_data") if (b := h(channel, extra.group(2))) is not None]
                channel = channel if found else None
                body, script = (found[0] if found else "").encode(), True
            else:
                data = json.dumps(ui_status(channel)) if channel else '{"error":"unknown"}'
                script = m and m.group(2) == "js"
                body = (f"window.liveData({data});" if script else data).encode()
            self.send_response(200 if channel else 404)
            self.send_header("Content-Type", "application/javascript" if script else "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    ThreadingHTTPServer(("127.0.0.1", CONFIG["ui_port"]), Handler).serve_forever()


