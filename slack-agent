def load_config() -> dict:
    if not CONFIG_PATH.exists():
        if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
            sys.exit(__doc__)
        sys.exit(f"slack-agent: no config at {CONFIG_PATH}; copy config.example.json there or set SLACK_AGENT_CONFIG")
    config = {**DEFAULTS, **json.loads(CONFIG_PATH.read_text())}
    for key in ("repo", "workspace", "state_dir", "claude_projects"):
        if config.get(key):
            config[key] = str(Path(config[key]).expanduser())
    for key in ("agent_command", "usage_check", "t3_tool"):
        if config.get(key):
            config[key] = [os.path.expanduser(a) for a in config[key]]
    return config


