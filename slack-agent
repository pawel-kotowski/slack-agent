def load_extensions() -> None:
    for path in CONFIG.get("extensions") or []:
        path = Path(path).expanduser()
        spec = importlib.util.spec_from_file_location(f"slack_agent_ext_{path.stem}", path)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        module.agent = sys.modules[__name__]  # after the file ran, so its own `agent = None` does not undo it
        EXTENSIONS.append(module)


