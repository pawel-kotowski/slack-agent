def t3(tool: str, args: dict) -> dict:
    """Call a T3 MCP tool. A failure comes back as {"error": <message>}."""
    try:
        out = subprocess.run([*CONFIG["t3_tool"], tool, json.dumps(args)], capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"error": repr(exc)}
    text = out.stdout if out.returncode == 0 else out.stderr
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        data = None
    if out.returncode:
        message = data.get("message") or data.get("code") if isinstance(data, dict) else None
        return {"error": message or (out.stderr + out.stdout).strip()[:500]}
    return data if isinstance(data, dict) else {"result": data}


_t3_project: list[str] = []


def t3_project() -> str | None:
    """The configured T3 project, or the one whose folder is the repo."""
    if CONFIG["t3_project"]:
        return CONFIG["t3_project"]
    if not _t3_project:
        repo, cursor = os.path.realpath(CONFIG["repo"]), 0
        while cursor is not None:
            page = t3("t3_project_list", {"limit": 100, "cursor": cursor})
            for p in page.get("projects", []):
                if not p.get("deletedAt") and os.path.realpath(p.get("workspaceRoot") or "") == repo:
                    _t3_project.append(p["id"])
            cursor = page.get("nextCursor") if not _t3_project else None
    return _t3_project[0] if _t3_project else None


def t3_launch(title: str, strategy: dict) -> dict:
    """An idle T3 thread: its id, worktree and branch, or an error."""
    project = t3_project()
    if not project:
        return {"error": f"no T3 project has the folder {CONFIG['repo']}; add it with `t3 project add`"}
    res = t3("t3_thread_launch", {
        "projectId": project, "title": title[:80], "workspaceStrategy": strategy, "runtimeMode": "full-access",
        "modelSelection": {"instanceId": CONFIG["t3_instance"], "model": CONFIG["t3_model"]}})
    if not res.get("threadId"):
        return {"error": res.get("error") or f"no thread: {res}"}
    # T3 makes the worktree after it answers: wait for its path.
    for _ in range(60):
        thread = t3("t3_thread_read", {"threadId": res["threadId"], "limit": 1}).get("thread") or {}
        if thread.get("worktreePath") and Path(thread["worktreePath"]).is_dir():
            break
        time.sleep(1)
    else:
        t3("t3_thread_organize", {"threadId": res["threadId"], "action": "archive"})
        return {"error": f"T3 made no worktree for thread {res['threadId']} in a minute"}
    return {"thread": res["threadId"], "path": thread["worktreePath"], "branch": thread.get("branch") or ""}


def t3_thread(thread: str) -> dict | None:
    """The thread as T3 shows it, or None when it is gone or archived."""
    found = t3("t3_thread_read", {"threadId": thread, "limit": 1}).get("thread")
    return None if not found or found.get("archived") else found


def t3_send(thread: str, text: str, mode: str = "auto") -> bool:
    """`auto` starts an idle thread, steers a running turn or queues; `queue` waits for the turn to end."""
    res = t3("t3_thread_send", {"threadId": thread, "mode": mode, "message": text})
    if res.get("error"):
        log("t3 send failed", thread, res["error"])
    return not res.get("error")


def write_agent_files(ws: str, conv: str, system: str) -> None:
    """The gate hook, SLACK_AGENT_CONV and the Slack rules for the agent in a T3 worktree. Claude Code
    reads `.claude/settings.local.json` (hooks, env, permissions) and `CLAUDE.local.md` (instructions
    it keeps after compaction) from the session's folder."""
    gate_cmd = f"SLACK_AGENT_CONV={shlex.quote(conv)} {ENV} {shlex.quote(str(SELF))} gate"
    settings = {"env": {"SLACK_AGENT_CONV": conv, "SLACK_AGENT_CONFIG": str(CONFIG_PATH)},
                # Nobody watches the thread: a question tool would wait there unseen.
                "permissions": {"deny": DENIED_TOOLS},
                "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [
                    {"type": "command", "command": gate_cmd, "timeout": APPROVAL_WAIT_S + 60}]}]}}
    write_json(Path(ws) / AGENT_FILES[0], settings)
    (Path(ws) / AGENT_FILES[1]).write_text(system)
    # Kept out of `git status`, so a finished task's workspace counts as clean and is removed.
    common = subprocess.run(["git", "-C", ws, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True).stdout.strip()
    if common:
        exclude = Path(common) / "info" / "exclude"
        exclude.parent.mkdir(parents=True, exist_ok=True)
        lines = exclude.read_text().splitlines() if exclude.exists() else []
        missing = [f"/{f}" for f in AGENT_FILES if f"/{f}" not in lines]
        if missing:
            with exclude.open("a") as f:
                f.write("".join(f"{line}\n" for line in ["# slack-agent's files for a task's agent", *missing]))


def start_detached(name: str, cwd: str, command: str) -> dict:
    """Run a shell command outside the listener, to stop with stop_detached: a transient systemd
    user unit on Linux, a process in a session of its own elsewhere. Output goes to <name>.log."""
    out = STATE_DIR / f"{name}.log"
    if sys.platform.startswith("linux") and shutil.which("systemd-run"):
        unit = f"slack-agent-{name}"
        subprocess.run(["systemctl", "--user", "reset-failed", unit], capture_output=True)
        res = subprocess.run(["systemd-run", "--user", "--collect", "--quiet", f"--unit={unit}",
                              f"--working-directory={cwd}", f"--setenv=PATH={os.environ.get('PATH', '')}",
                              f"--property=StandardOutput=append:{out}", f"--property=StandardError=append:{out}",
                              "bash", "-lc", command], capture_output=True, text=True)
        if res.returncode == 0:
            return {"unit": unit}
        log("systemd-run failed", unit, res.stderr.strip()[:300])
    with out.open("a") as f:
        proc = subprocess.Popen(["bash", "-lc", command], cwd=cwd, stdin=subprocess.DEVNULL, stdout=f,
                                stderr=subprocess.STDOUT, start_new_session=True)
    threading.Thread(target=proc.wait, daemon=True).start()  # reaped when it ends, if this process lives on
    return {"pid": proc.pid}


def stop_detached(proc: dict) -> None:
    if proc.get("unit"):
        subprocess.run(["systemctl", "--user", "stop", proc["unit"]], capture_output=True)
    elif proc.get("pid"):
        try:
            os.killpg(proc["pid"], signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass


def slug(text: str) -> str:
    plain = unicodedata.normalize("NFKD", re.sub(r"<[^>]*>", " ", text).replace("ł", "l").replace("Ł", "L")).encode("ascii", "ignore").decode()
    words = re.findall(r"[a-z0-9]+", plain.lower())[:5]
    return "-".join(words)[:60].rstrip("-") + "-" + uuid.uuid4().hex[:4]


