def channel_allowed(channel: str | None) -> bool:
    """Whether the bot works in and reads this channel: one the config's `channels` lists (all when
    it lists none), a DM, or a code channel of one of its own tasks."""
    listed = CONFIG["channels"]
    return bool(channel) and (not listed or channel in listed or channel.startswith("D")
                              or conv_state(channel).exists())


SECRETS_FILE = HOME / ".config/slack-agent" / f"{CONFIG['keychain_service']}.json"


def secret(name: str) -> str:
    if sys.platform != "darwin":
        return json.loads(SECRETS_FILE.read_text())[name]
    return subprocess.run(
        ["security", "find-generic-password", "-s", CONFIG["keychain_service"], "-a", name, "-w"],
        check=True, capture_output=True, text=True,
    ).stdout.strip()


def store_secret(name: str, value: str) -> None:
    if sys.platform == "darwin":
        subprocess.run(["security", "add-generic-password", "-U", "-s", CONFIG["keychain_service"], "-a", name,
                        "-w", value], check=True)
        return
    data = json.loads(SECRETS_FILE.read_text()) if SECRETS_FILE.exists() else {}
    data[name] = value
    SECRETS_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = SECRETS_FILE.with_suffix(".tmp")
    tmp.touch(mode=0o600)
    tmp.write_text(json.dumps(data, indent=1))
    tmp.replace(SECRETS_FILE)


def log(*parts: object) -> None:
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + " ".join(str(p) for p in parts)
    print(line, flush=True)
    with LOG.open("a") as f:
        f.write(line + "\n")


def read_json(path: Path, default):
    return json.loads(path.read_text()) if path.exists() else default


def write_json(path: Path, value) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(value, indent=1))
    tmp.replace(path)


def split(conv: str) -> tuple[str, str | None]:
    channel, _, thread = conv.partition("-")
    return channel, thread or None


def conv_state(conv: str) -> Path:
    return STATE_DIR / f"{conv}.json"


def update_state(conv: str, **values) -> dict:
    state = read_json(conv_state(conv), {})
    state.update(values)
    write_json(conv_state(conv), state)
    return state


# Shell commands that wait for an owner's Approve click (the PreToolUse hook). The command is
# split into simple commands (heredoc bodies dropped, quotes kept as one word), so text that only
# mentions a command, in a heredoc or a commit message, is not run and does not count. Pushing any
# branch but main or the default branch (also with --force-with-lease), opening a pull request, deleting local branches
# and removing files inside the task's workspace or the temp directory need no approval.
MAIN_BRANCHES = {"main", "master"}
SHELLS = {"bash", "sh", "zsh", "dash"}
PREFIXES = {"sudo", "command", "time", "nohup", "exec", "env", "builtin", "xargs"}
SEPARATORS = {";", "&&", "||", "|", "&", "(", ")", "\n", "|&", ";;"}


def _drop_heredocs(command: str) -> str:
    out, pos = [], 0
    for m in re.finditer(r"<<-?\s*(['\"]?)([A-Za-z_][\w.-]*)\1", command):
        if m.start() < pos:
            continue
        line_end = command.find("\n", m.end())
        if line_end < 0:
            break
        end = re.compile(rf"^[ \t]*{re.escape(m.group(2))}[ \t]*$", re.M).search(command, line_end + 1)
        out.append(command[pos:line_end + 1])
        pos = end.end() if end else len(command)
    return "".join(out) + command[pos:]


def _simple_commands(command: str) -> list[list[str]]:
    lex = shlex.shlex(_drop_heredocs(command).replace("$(", "( ").replace("`", " ; "),
                      posix=True, punctuation_chars=";&|()\n")
    lex.whitespace = " \t\r"
    lex.whitespace_split = True
    lex.commenters = ""
    words, out = [], []
    try:
        for token in lex:
            if token in SEPARATORS or set(token) <= set(";&|()\n"):
                out.append(words)
                words = []
            elif token.startswith("#") and not words:
                lex.instream.readline()  # a comment runs to the end of its line
                out.append(words)
            else:
                words.append(token)
    except ValueError:  # an unclosed quote: judge the words read so far
        pass
    out.append(words)
    return [w for w in out if w]


def _inside(path: str, roots: list[str]) -> bool:
    real = os.path.realpath(path)
    return any(real != root and real.startswith(root.rstrip("/") + "/") for root in roots)


def risky(command: str, cwd: str, workspace: str | None) -> list[tuple[str, str]]:
    """The steps in `command` that need an owner's approval, as (kind, detail); empty: none."""
    roots = [os.path.realpath(p) for p in
             filter(None, [workspace, "/tmp", "/private/tmp", "/var/tmp", os.environ.get("TMPDIR")])]
    found: list[tuple[str, str]] = []
    for words in _simple_commands(command):
        while words and (re.fullmatch(r"\w+=.*", words[0]) or words[0] in PREFIXES):
            words = words[1:]
        if not words:
            continue
        prog, args = os.path.basename(words[0]), words[1:]
        if prog in SHELLS and "-c" in args[:-1]:
            found += risky(args[args.index("-c") + 1], cwd, workspace)
        elif prog == "eval":
            found += risky(" ".join(args), cwd, workspace)
        elif prog == "cd" and args:
            cwd = os.path.join(cwd, os.path.expanduser(args[0]))
        elif prog == "git":
            while args and args[0].startswith("-"):  # git's own options: -C <dir>, -c <k=v>, ...
                if args[0] == "-C" and len(args) > 1:
                    cwd = os.path.join(cwd, os.path.expanduser(args[1]))
                args = args[2:] if args[0] in ("-C", "-c") else args[1:]
            sub, rest = (args[0], args[1:]) if args else ("", [])
            flags = [a for a in rest if a.startswith("-")]
            short = "".join(a[1:] for a in flags if not a.startswith("--"))
            if sub == "push":
                refs = [a for a in rest if not a.startswith("-")][1:]
                if "--force" in flags or "f" in short or any(r.startswith("+") for r in refs):
                    found.append(("force push", " ".join(refs)))
                if {"--delete", "--mirror", "--prune"} & set(flags) or "d" in short \
                        or any(r.startswith(":") for r in refs):
                    found.append(("delete a remote branch", " ".join(refs)))
                for ref in refs:
                    dest = ref.lstrip("+").rpartition(":")[2].removeprefix("refs/heads/")
                    if dest in MAIN_BRANCHES | {base_branch()}:
                        found.append((f"push to {dest}", ref))
            elif sub == "reset" and "--hard" in flags:
                found.append(("git reset --hard", "drops uncommitted work"))
            elif sub == "clean" and ("--force" in flags or "f" in short):
                found.append(("git clean -f", "deletes untracked files"))
            elif sub == "checkout" and "--" in rest:
                found.append(("git checkout --", "drops uncommitted changes"))
        elif prog == "gh" and args and args[0] == "api":
            method = next((args[i + 1] for i, a in enumerate(args[:-1]) if a in ("-X", "--method")),
                          next((a.split("=", 1)[1] for a in args if a.startswith("--method=")), "GET"))
            valued = {"-X", "--method", "-f", "-F", "--field", "--raw-field", "-H", "--header", "--input",
                      "-q", "--jq", "-t", "--template", "--hostname", "--cache", "-p", "--preview"}
            path = next((a for prev, a in zip(args, args[1:]) if not a.startswith("-") and prev not in valued), "")
            writes = method.upper() != "GET" or any(a in ("-f", "-F", "--field", "--raw-field") for a in args)
            if writes and re.search(r"/pulls/\d+/merge", path) or re.search(r"\b(merge|close)PullRequest\b", " ".join(args)):
                found.append(("merge or close a pull request through gh api", path))
            elif method.upper() == "DELETE":
                found.append(("gh api DELETE", path))
        elif prog == "gh" and args:
            pair = " ".join(args[:2])
            if pair in ("pr merge", "pr close", "repo delete") \
                    or (args[0] == "release" and pair not in ("release view", "release list", "release download")):
                target = " ".join(a for a in args[2:3] if not a.startswith("-"))
                found.append((f"gh {pair}", target))
        elif prog == "rm":
            opts = [a for a in args if a.startswith("-") and a != "-"]
            if not ({"--recursive", "--force"} & set(opts) or any(set(a[1:]) & set("rRf") for a in opts
                                                                       if not a.startswith("--"))):
                continue
            paths = args[args.index("--") + 1:] if "--" in args else [a for a in args if not a.startswith("-")]
            outside = []
            for p in paths:
                p = os.path.expandvars(os.path.expanduser(p))
                stem = re.split(r"[*?\[{]", p)[0]  # a glob: judge the directory it starts in
                if "$" in stem or not _inside(os.path.join(cwd, stem or "."), roots):
                    outside.append(p)
            if outside or not paths:
                found.append(("delete outside the workspace", " ".join(outside) or "paths from stdin"))
    return found


def set_status(web: WebClient, conv: str, status: str, title: str | None = None) -> None:
    channel, thread = split(conv)
    body = {"channel_id": channel, "status": status}
    if thread:
        body["thread_ts"] = thread
    if title:
        body["title"] = title[:200]
    web.api_call("agents.sessions.setStatus", json=body)
    update_state(conv, status=status, status_at=time.time())


def set_bar(web: WebClient, channel: str, items: list[dict]) -> None:
    # Slack shows at most 5 items: the workspace item goes first, then the repo.
    for key in ("workspace", "repo"):
        if len(items) > 5:
            items = [i for i in items if i["key"] != key]
    web.api_call("agents.conversations.setProperties",
                 json={"channel_id": channel, "code_channel": {"context_bar_items": items[:5]}})
    update_state(channel, bar=items[:5])


def post(web: WebClient, conv: str, text: str, blocks: list | None = None) -> str:
    channel, thread = split(conv)
    body = {"channel": channel, "markdown_text": text}
    if blocks:
        body = {"channel": channel, "text": text[:3000], "blocks": blocks}
    if thread:
        body["thread_ts"] = thread
    try:
        return web.api_call("chat.postMessage", json=body)["ts"]
    except SlackApiError:
        return web.chat_postMessage(channel=channel, thread_ts=thread, text=text)["ts"]


# On Linux, `orca` is often GNOME's screen reader; Orca's own CLI is `orca-ide` there.
ORCA = "orca-ide" if sys.platform != "darwin" and shutil.which("orca-ide") else "orca"


def base_branch() -> str:
    """The repo's default branch, as `origin/HEAD` names it; `workspace()` refreshes it from GitHub."""
    out = subprocess.run(["git", "-C", str(Path(CONFIG["repo"]).expanduser()), "symbolic-ref", "--short",
                          "refs/remotes/origin/HEAD"], capture_output=True, text=True).stdout.strip()
    return out.removeprefix("origin/") or "main"


def orca(*args: str) -> dict:
    out = subprocess.run([ORCA, *args, "--json"], capture_output=True, text=True)
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return {"ok": False, "error": (out.stdout + out.stderr).strip()[:500]}


def close_seeded_terminals(path: str) -> None:
    """Close the shells Orca opens in a new worktree, before the task's own terminal starts.

    Orca makes the repo's `orca.yaml` `defaultTabs` (or one plain shell when it has none) for every
    new worktree, also with `--setup skip`, where their commands do not run: idle shells nobody
    uses. `worktree create` returns before they exist, so wait for them (a few seconds at most).
    """
    for _ in range(20):
        terminals = (orca("terminal", "list", "--worktree", f"path:{path}").get("result") or {}).get("terminals")
        if terminals:
            time.sleep(1)  # the tabs are made one after another
            orca("terminal", "close", "--worktree", f"path:{path}", "--all")
            return
        time.sleep(0.25)


